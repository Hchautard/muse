    {
      "id": "bach",
      "type": "person",
      "name": "Jean-Sébastien Bach",
      "wikidataId": "Q1339",
      "yearStart": 1685,
      "yearEnd": 1750,
      "summary": "Compositeur et organiste allemand, figure majeure de la musique baroque. Son œuvre immense — cantates, passions, pièces pour orgue, pour clavier ou pour orchestre — porte l'art du contrepoint à un sommet.",
      "mediaIds": [
        "bach-image"
      ]
    },
    {
      "id": "vivaldi",
      "type": "person",
      "name": "Antonio Vivaldi",
      "wikidataId": "Q1340",
      "yearStart": 1678,
      "yearEnd": 1741,
      "summary": "Compositeur et violoniste vénitien, prêtre surnommé « le Prêtre roux ». Il a écrit des centaines de concertos, dont Les Quatre Saisons, et a contribué à fixer la forme du concerto en trois mouvements.",
      "mediaIds": [
        "vivaldi-image"
      ]
    },
    {
